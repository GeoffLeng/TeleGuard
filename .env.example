# ==========================================
# TeleGuard - Environment Configuration
# ==========================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Web Admin & API Server Port
PORT=3000

# Web Dashboard Master Password
ADMIN_PASSWORD=change_this_password_in_production

# Optional IP Whitelist for Password Login (comma-separated, leave empty to allow all)
ADMIN_IP_WHITELIST=

# Super Admin Telegram User IDs (comma-separated)
# Users with these Telegram IDs can login via Telegram 2FA code and are exempt from bot moderation
SA_ADMIN_TG_IDS=

# WebApp & Leaderboard URL
WEBAPP_URL=http://localhost:3000/leaderboard
TELEGRAM_APP_URL=

# SQLite Database Paths
DB_PATH=./teleguard.db
DRAW_DB_PATH=./drawbot.db

# Optional Userbot MTProto Configuration (for Recent Actions Group Audit Logger)
# Obtain API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=
MONITOR_CHAT_IDS=
USERBOT_POLL_INTERVAL_MS=3600000
